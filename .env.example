# Run bash scripts/init.sh to generate API_TOKEN and DASHBOARD_PASSWORD.
TZ=Asia/Shanghai
STACK_VERSION=local
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8890
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=__GENERATE__
API_TOKEN=__GENERATE__
DNS_PRIMARY=223.5.5.5
DNS_SECONDARY=119.29.29.29

# Leave email empty until you configure your own account.
# Single quotes protect literal dollar signs and # characters in passwords.
ACCOUNT_1_EMAIL=
ACCOUNT_1_PASSWORD=
ACCOUNT_1_LANG_CODE=zh-CN
ACCOUNT_1_GEO_LOCALE=CN
ACCOUNT_1_SAVE_FINGERPRINT_MOBILE=true
ACCOUNT_1_SAVE_FINGERPRINT_DESKTOP=true
# ACCOUNT_1_TOTP_SECRET=
# ACCOUNT_1_RECOVERY_EMAIL=

# Copy the ACCOUNT_1_* block and change the number for additional accounts.
# ACCOUNT_2_EMAIL=
# ACCOUNT_2_PASSWORD=
# ACCOUNT_2_LANG_CODE=zh-CN
# ACCOUNT_2_GEO_LOCALE=CN
